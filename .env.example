# 실제 값은 .env 에 넣는다. 이 파일에는 이름만 둔다.
MOLIT_SERVICE_KEY=
MOLIT_ENDPOINT=
VITE_NAVER_MAP_CLIENT_ID=
# 건축물대장(국토교통부_건축HUB_건축물대장정보 서비스). 공공데이터포털 같은 계정이면 키는 MOLIT_SERVICE_KEY 와 같아도 된다
BLD_SERVICE_KEY=
BLD_ENDPOINT=

# 행정안전부 도로명주소 좌표제공·검색 API 승인키 (business.juso.go.kr). 단지 주소 → 좌표 (fetch:molit, regeocode:juso)
JUSO_CONFIRM_KEY=
